using Xunit;
// using StaticMapper = HyperMapper.Generated.Mapper;  // TODO: Uncomment when Source Generator is working

namespace HyperMapper.IntegrationTests;

/// <summary>
/// v11.0.0: Tests for static Mapper.Map&lt;S,D&gt;() API - the high-performance CodeGen entry point.
/// Target: ~21ns performance (equivalent to manual mapping).
/// </summary>
public class StaticMapperTests
{
    #region Test Types

    public class Person
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public int Age { get; set; }
    }

    public class PersonDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public int Age { get; set; }
    }

    public class Order
    {
        public int OrderId { get; set; }
        public decimal Total { get; set; }
        public Person? Customer { get; set; }
    }

    public class OrderDto
    {
        public int OrderId { get; set; }
        public decimal Total { get; set; }
        public PersonDto? Customer { get; set; }
    }

    public class Address
    {
        public string Street { get; set; } = "";
        public string City { get; set; } = "";
        public string Country { get; set; } = "";
    }

    public class AddressDto
    {
        public string Street { get; set; } = "";
        public string City { get; set; } = "";
        public string Country { get; set; } = "";
    }

    #endregion

    #region Test Profiles

    public class PersonProfile : Profile
    {
        public PersonProfile()
        {
            CreateMap<Person, PersonDto>();
        }
    }

    public class OrderProfile : Profile
    {
        public OrderProfile()
        {
            CreateMap<Person, PersonDto>();
            CreateMap<Order, OrderDto>();
        }
    }

    public class AddressProfile : Profile
    {
        public AddressProfile()
        {
            CreateMap<Address, AddressDto>();
        }
    }

    #endregion

    #region Basic Mapping Tests

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_SimpleObject_MapsAllProperties()
    {
        // Arrange
        var source = new Person { Id = 1, Name = "John", Email = "john@test.com", Age = 30 };

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(1, result.Id);
        Assert.Equal("John", result.Name);
        Assert.Equal("john@test.com", result.Email);
        Assert.Equal(30, result.Age);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_NullSource_ReturnsNull()
    {
        // Arrange
        Person? source = null;

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source!);

        // Assert
        Assert.Null(result);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_EmptyObject_MapsWithDefaults()
    {
        // Arrange
        var source = new Person();

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(0, result.Id);
        Assert.Equal("", result.Name);
        Assert.Equal("", result.Email);
        Assert.Equal(0, result.Age);
    }

    #endregion

    #region Nested Object Tests

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_NestedObject_MapsCorrectly()
    {
        // Arrange
        var source = new Order
        {
            OrderId = 100,
            Total = 99.99m,
            Customer = new Person { Id = 1, Name = "Jane", Email = "jane@test.com", Age = 25 }
        };

        // Act
        var result = StaticMapper.Map<Order, OrderDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(100, result.OrderId);
        Assert.Equal(99.99m, result.Total);
        Assert.NotNull(result.Customer);
        Assert.Equal("Jane", result.Customer.Name);
        Assert.Equal(25, result.Customer.Age);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_NestedObjectWithNullChild_MapsCorrectly()
    {
        // Arrange
        var source = new Order
        {
            OrderId = 200,
            Total = 50.00m,
            Customer = null
        };

        // Act
        var result = StaticMapper.Map<Order, OrderDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(200, result.OrderId);
        Assert.Equal(50.00m, result.Total);
        Assert.Null(result.Customer);
    }

    #endregion

    #region Multiple Mappings Tests

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_MultipleDifferentTypes_AllWork()
    {
        // Arrange
        var person = new Person { Id = 1, Name = "Test", Email = "test@test.com", Age = 40 };
        var address = new Address { Street = "123 Main", City = "NYC", Country = "USA" };

        // Act
        var personResult = StaticMapper.Map<Person, PersonDto>(person);
        var addressResult = StaticMapper.Map<Address, AddressDto>(address);

        // Assert
        Assert.NotNull(personResult);
        Assert.Equal("Test", personResult.Name);
        Assert.NotNull(addressResult);
        Assert.Equal("123 Main", addressResult.Street);
        Assert.Equal("NYC", addressResult.City);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_SameTypeTwice_BothWork()
    {
        // Arrange
        var person1 = new Person { Id = 1, Name = "First", Email = "first@test.com", Age = 20 };
        var person2 = new Person { Id = 2, Name = "Second", Email = "second@test.com", Age = 30 };

        // Act
        var result1 = StaticMapper.Map<Person, PersonDto>(person1);
        var result2 = StaticMapper.Map<Person, PersonDto>(person2);

        // Assert
        Assert.NotNull(result1);
        Assert.NotNull(result2);
        Assert.Equal("First", result1.Name);
        Assert.Equal("Second", result2.Name);
        Assert.Equal(20, result1.Age);
        Assert.Equal(30, result2.Age);
    }

    #endregion

    #region Edge Cases

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_StringProperties_PreservesValues()
    {
        // Arrange
        var source = new Person
        {
            Id = 1,
            Name = "Name with spaces and special chars: @#$%",
            Email = "test+special@example.com",
            Age = 99
        };

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal("Name with spaces and special chars: @#$%", result.Name);
        Assert.Equal("test+special@example.com", result.Email);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_EmptyStrings_PreservesEmpty()
    {
        // Arrange
        var source = new Person { Id = 1, Name = "", Email = "", Age = 0 };

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal("", result.Name);
        Assert.Equal("", result.Email);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_MaxValues_HandlesCorrectly()
    {
        // Arrange
        var source = new Person { Id = int.MaxValue, Name = "Max", Email = "max@test.com", Age = int.MaxValue };

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(int.MaxValue, result.Id);
        Assert.Equal(int.MaxValue, result.Age);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_MinValues_HandlesCorrectly()
    {
        // Arrange
        var source = new Person { Id = int.MinValue, Name = "Min", Email = "min@test.com", Age = int.MinValue };

        // Act
        var result = StaticMapper.Map<Person, PersonDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(int.MinValue, result.Id);
        Assert.Equal(int.MinValue, result.Age);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_DecimalPrecision_Preserved()
    {
        // Arrange
        var source = new Order { OrderId = 1, Total = 123.456789m, Customer = null };

        // Act
        var result = StaticMapper.Map<Order, OrderDto>(source);

        // Assert
        Assert.NotNull(result);
        Assert.Equal(123.456789m, result.Total);
    }

    #endregion

    #region Performance Characteristics

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_IsStaticMethod_NoInstanceRequired()
    {
        // This test verifies the API is static - no mapper instance needed
        var source = new Person { Id = 1, Name = "Static", Email = "static@test.com", Age = 50 };

        // Direct static call - no setup, no initialization
        var result = StaticMapper.Map<Person, PersonDto>(source);

        Assert.NotNull(result);
        Assert.Equal("Static", result.Name);
    }

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_MultipleCallsInLoop_AllSucceed()
    {
        // Arrange
        const int iterations = 1000;
        var source = new Person { Id = 1, Name = "Loop", Email = "loop@test.com", Age = 25 };

        // Act & Assert - no exceptions, all mappings succeed
        for (int i = 0; i < iterations; i++)
        {
            var result = StaticMapper.Map<Person, PersonDto>(source);
            Assert.NotNull(result);
            Assert.Equal("Loop", result.Name);
        }
    }

    #endregion

    #region Unmapped Types

    [Fact(Skip = "TODO: Enable when Source Generator is working")]
    public void Map_UnmappedType_ReturnsDefault()
    {
        // Arrange - using types that don't have a mapping registered
        var source = new UnmappedSource { Value = "test" };

        // Act - MapDirect returns default for unmapped types
        var result = StaticMapper.Map<UnmappedSource, UnmappedDest>(source);

        // Assert - should return null/default since no mapping exists
        Assert.Null(result);
    }

    public class UnmappedSource { public string Value { get; set; } = ""; }
    public class UnmappedDest { public string Value { get; set; } = ""; }

    #endregion
}
