<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Package Info -->
    <PackageId>HyperMapper</PackageId>
    <Version>11.0.0</Version>
    <Authors>HyperMapper Contributors</Authors>
    <Description>High-performance object mapper with 100% AutoMapper API compatibility and Source Generator support</Description>
    <PackageTags>mapper;automapper;dto;mapping;sourcegenerator;hypermapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Source Generator for compile-time mapping code generation -->
  <ItemGroup>
    <ProjectReference Include="..\HyperMapper.SourceGenerator\HyperMapper.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
