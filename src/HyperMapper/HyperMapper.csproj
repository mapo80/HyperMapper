<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Package Info -->
    <PackageId>HyperMapper.Core</PackageId>
    <Version>12.2.0</Version>
    <Authors>HyperMapper Contributors</Authors>
    <Description>High-performance object mapper with 100% AutoMapper API compatibility and Source Generator support</Description>
    <PackageTags>mapper;automapper;dto;mapping;sourcegenerator;hypermapper</PackageTags>
    <PackageProjectUrl>https://github.com/mapo80/HyperMapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mapo80/HyperMapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Source Generator for compile-time mapping code generation -->
  <ItemGroup>
    <ProjectReference Include="..\HyperMapper.SourceGenerator\HyperMapper.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
